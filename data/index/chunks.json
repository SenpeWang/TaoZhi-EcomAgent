[{"id": "c1", "doc_id": "", "doc_name": "MC-500规格说明书", "source": "", "url": "", "doc_type": "spec_sheet", "section": "", "page": null, "text": "膜法工坊 MC-500 膜切机，切幅为120mm，双刀头配置，切割精度达到0.05mm，支持陶瓷膜、防窥膜与防爆膜。", "order": 0, "owner_id": "", "org_tag": "", "is_public": true, "meta": {}}, {"id": "c2", "doc_id": "", "doc_name": "MC-300规格说明书", "source": "", "url": "", "doc_type": "spec_sheet", "section": "", "page": null, "text": "膜法工坊 MC-300 膜切机，切幅为80mm，单刀头，便携式设计，适合中小型门店入门使用。", "order": 0, "owner_id": "", "org_tag": "", "is_public": true, "meta": {}}, {"id": "c3", "doc_id": "", "doc_name": "机型适配规范", "source": "", "url": "", "doc_type": "spec_sheet", "section": "", "page": null, "text": "C5陶瓷防窥膜专为华为 Mate X5 折叠屏手机外屏设计，不适配内屏。内屏推荐使用水凝膜软膜。", "order": 0, "owner_id": "", "org_tag": "", "is_public": true, "meta": {}}, {"id": "c4", "doc_id": "", "doc_name": "售后保修手册", "source": "", "url": "", "doc_type": "policy", "section": "", "page": null, "text": "膜切机整机质保1年，刀头与耗材保修3个月。7天内质量问题包退，15天内包换，终身提供远程技术指导。", "order": 0, "owner_id": "", "org_tag": "", "is_public": true, "meta": {}}]