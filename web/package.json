{
  "name": "taozhi-ecom-agent",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "python3 ../scripts/check_development.py lint",
    "lint:fix": "eslint . --fix",
    "format:check": "python3 ../scripts/check_development.py format-check",
    "format": "python3 ../scripts/check_development.py format",
    "check:commits": "python3 ../scripts/check_development.py commits"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.13.0",
    "dayjs": "^1.11.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.0.0",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "prettier": "3.9.9",
    "eslint-plugin-vue": "10.11.1",
    "typescript-eslint": "8.71.1",
    "vue-eslint-parser": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.2.0",
    "globals": "^16.0.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3"
  }
}
