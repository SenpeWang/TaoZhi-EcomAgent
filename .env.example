# ─── LLM 服务层（OpenAI 兼容端点） ───
BASE_URL="https://token.sensenova.cn/v1"
API_KEY=""
MODEL="sensenova-6.8-flash-lite"

# 模型分级路由（留空则回退到 MODEL）
LLM_FAST_MODEL=""
LLM_STRONG_MODEL=""
LLM_VISION_MODEL=""
LLM_MAX_TOKENS=8192

# ─── Embedding ───
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=256

# ─── 基础设施（企业在线链路：MinIO 附件 / Kafka 任务 / ES 检索） ───
# 三者均可独立关闭并自动降级：附件回落本地私有目录，任务回落数据库轮询，检索回落本地五信号链路
ECOM_MINIO_ENABLED="false"
ECOM_MINIO_ENDPOINT="127.0.0.1:19000"
ECOM_MINIO_ACCESS_KEY=""
ECOM_MINIO_SECRET_KEY=""
ECOM_MINIO_BUCKET="ecom-private"
ECOM_PRESIGN_TTL="600"
# 迁移期双写：MinIO 与本地目录同时落盘，比对一致后置 false 停写本地
ECOM_BLOB_DUAL_WRITE="false"

ECOM_KAFKA_ENABLED="false"
ECOM_KAFKA_BROKERS="127.0.0.1:9092"
ECOM_KAFKA_TOPIC="ecom.tasks"
ECOM_KAFKA_PARTITIONS="6"

ECOM_ES_ENABLED="false"
ECOM_ES_URL="http://127.0.0.1:9200"
ECOM_ES_INDEX="chunks_v1"
# 中文分词：需集群已安装 analysis-ik；缺失时自动回落内置 cjk
ECOM_ES_ANALYZER="ik_max_word"
ECOM_ES_SEARCH_ANALYZER="ik_smart"

# ─── 安全 ───
AUTH_ENABLED=false
JWT_SECRET="change-me-in-production"

# ─── 可观测性 ───
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ecom-copilot"

# ─── Agent 编排 ───
MAX_PARALLEL_SUBAGENTS=4
MAX_HYPOTHESIS_ROUNDS=6
CONFIDENCE_REVIEW_THRESHOLD=0.6
SYNTHETIC_FALLBACK_ENABLED=false

# ─── 会话记忆 / FAQ 缓存 / 拒答门禁 ───
# 总开关：false 时历史注入、摘要压缩与 FAQ 语义缓存全部静默关闭
MEMORY_ENABLED=true
# 注入给 Supervisor 规划与答案生成的会话历史轮数（近 N 轮）
MEMORY_HISTORY_TURNS=6
# 会话历史超过该 token 估算值时触发 LLM 摘要压缩
MEMORY_SUMMARY_THRESHOLD=3000
# FAQ 语义缓存命中所需的最低 embedding 余弦相似度
FAQ_CACHE_SIM_THRESHOLD=0.92
# 拒答门禁：核验置信度低于该值时输出结构化拒答而非编造
REJECT_CONFIDENCE_THRESHOLD=0.3

# Enterprise trial (configure a strong secret before APP_ENV=production)
APP_ENV=dev
LLM_DIRECT_CONNECTION=true
SYNTHETIC_FALLBACK_ENABLED=false
RETRIEVAL_FIRST_ENABLED=true
TASK_MAX_PENDING=50
TASK_TIMEOUT_SECONDS=900
SPECIALIST_TIMEOUT_SECONDS=90
BUSINESS_API_URL=
BUSINESS_API_TOKEN=
BUSINESS_SNAPSHOT_MAX_AGE=60
CORS_ORIGINS=["http://localhost:18501"]

# 默认部署企业，客户端不能伪造此身份
AUTH_DEFAULT_ORG=手机配件公司

# ─── 语义检索（本地嵌入服务，scripts/embedding_server.py，sp_llm 环境运行） ───
# 服务不可用时检索自动降级为 BM25+字符向量两路；留空则使用默认回环地址
ECOM_EMBED_SERVICE_URL="http://127.0.0.1:18555"
# HyDE：检索前由 LLM 生成假设性答案作为第四路检索信号；false 时关闭
ECOM_HYDE_ENABLED="true"
