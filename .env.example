# ─── LLM 服务层（OpenAI 兼容端点） ───
BASE_URL="https://token.sensenova.cn/v1"
API_KEY=""
MODEL="sensenova-6.8-flash"

# 模型分级路由（留空则回退到 MODEL）
LLM_FAST_MODEL=""
LLM_STRONG_MODEL=""
LLM_VISION_MODEL=""
LLM_MAX_TOKENS=8192
LLM_DIRECT_CONNECTION=true

# 商汤 sensenova-6.8-flash 国内多 Key 与海外版容灾中间件配置（全线统一模型，无第三方云）
SENSENOVA_CN_SECONDARY_API_KEY=""
SENSENOVA_OVERSEAS_BASE_URL="https://token.sensenova.ai/v1"
SENSENOVA_OVERSEAS_API_KEY=""
SENSENOVA_OVERSEAS_MODEL="sensenova-6.8-flash"
SENSENOVA_OVERSEAS_DIRECT_CONNECTION="false"

# ─── 企业在线链路（必填）───────────────────────────
# 企业代码只读 ECOM_* 变量，环境文件由 ECOM_ENV_FILE 指定（supervisor 下 api/worker 用 .env.production）
# 缺 ECOM_MODE 或 ECOM_DATABASE_URL 会直接启动失败，不要省略
ECOM_MODE="production"            # 仅允许 production / test
ECOM_ENV_FILE="/path/to/.env.production"
ECOM_DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:15432/ecom_production"
ECOM_TENANT_CODE="mofa"

# ─── 基础设施（企业在线链路：MinIO 附件 / Kafka 任务 / ES 检索） ───
# 三者均可独立关闭并自动降级：附件回落本地私有目录，任务回落数据库轮询，检索回落本地五信号链路
ECOM_MINIO_ENABLED="false"
ECOM_MINIO_ENDPOINT="127.0.0.1:19000"
ECOM_MINIO_ACCESS_KEY=""
ECOM_MINIO_SECRET_KEY=""
ECOM_MINIO_BUCKET="ecom-private"
ECOM_PRESIGN_TTL="600"
# 迁移期双写：MinIO 与本地目录同时落盘，比对一致后置 false 停写本地
ECOM_BLOB_DUAL_WRITE="false"

ECOM_KAFKA_ENABLED="false"
ECOM_KAFKA_BROKERS="127.0.0.1:9092"
ECOM_KAFKA_TOPIC="ecom.tasks"
ECOM_KAFKA_PARTITIONS="6"

ECOM_ES_ENABLED="false"
ECOM_ES_URL="http://127.0.0.1:9200"
ECOM_ES_INDEX="chunks"
# 中文分词：需集群已安装 analysis-ik；缺失时自动回落内置 cjk
ECOM_ES_ANALYZER="ik_max_word"
ECOM_ES_SEARCH_ANALYZER="ik_smart"

# ─── 检索质量（企业在线链路，改前先跑 scripts/experiment_distance_threshold.py 看数据）───
ECOM_ANN_MAX_DIST="0.45"          # 存在性闸门：最近切片距离仍超此值即判资料不足
ECOM_RERANK_ENABLED="true"
ECOM_RERANK_CANDIDATES="20"
ECOM_RERANK_TIMEOUT="20"          # 精排超时即回落融合序，不拖慢问答
ECOM_RERANK_CHARS="1000"          # 送交叉编码器的单条字符预算
ECOM_RERANK_MIN_SCORE="0.05"      # 精排分绝对阈值
ECOM_RERANK_RELATIVE="0.15"       # 精排分相对阈值（低于首条该比例即丢弃）
ECOM_MAX_CHUNKS_PER_DOC="3"       # 同一文档最多进入结果的切片数
ECOM_QUOTE_MAX_CHARS="1200"       # 单条正文兜底截断长度

# ─── Agent 编排与业务接口 ───
MAX_PARALLEL_SUBAGENTS=4
BUSINESS_API_URL=
BUSINESS_API_TOKEN=

# ─── 语义检索（本地嵌入服务，scripts/embedding_server.py，conda llm 环境运行） ───
# 服务不可用时检索自动降级为 BM25+字符向量两路；留空则使用默认回环地址
ECOM_EMBED_SERVICE_URL="http://127.0.0.1:18555"
# HyDE：检索前由 LLM 生成假设性答案作为第四路检索信号；false 时关闭
ECOM_HYDE_ENABLED="true"
