# ─── LLM 服务层（OpenAI 兼容端点） ───
BASE_URL="https://token.sensenova.cn/v1"
API_KEY=""
MODEL="sensenova-6.8-flash"

# 模型分级路由（留空则回退到 MODEL）
LLM_FAST_MODEL=""
LLM_STRONG_MODEL=""
LLM_VISION_MODEL=""
LLM_MAX_TOKENS=8192
LLM_DIRECT_CONNECTION=true

# 多通道容灾顺位：商汤海外版 -> Dots -> 商汤国内主 Key（及可选国内备选 Key）
SENSENOVA_OVERSEAS_BASE_URL="https://token.sensenova.ai/v1"
SENSENOVA_OVERSEAS_API_KEY=""
SENSENOVA_OVERSEAS_MODEL="sensenova-6.8-flash"
SENSENOVA_OVERSEAS_DIRECT_CONNECTION="false"
DOTS_BASE_URL="https://note3-prev-api.askdiandian.com/v1"
DOTS_API_KEY=""
DOTS_MODEL="dots3-note-prev"
DOTS_DIRECT_CONNECTION="true"
SENSENOVA_CN_SECONDARY_API_KEY=""

# ─── 容器编排（Docker Compose）───────────────────────────
# 若宿主机已安装 nvidia-container-toolkit，取消下一行注释即可默认启用 GPU 向量加速
# COMPOSE_FILE="docker-compose.yml:docker-compose.gpu.yml"
ECOM_PG_USER="ecom_production"
ECOM_PG_PASSWORD=""
ECOM_PG_DB="ecom_production"
ECOM_MODELS_DIR="../models"

# ─── 企业在线链路（必填）───────────────────────────
# 企业代码只读 ECOM_* 变量；容器内由 docker-compose.yml 自动注入内网地址，本机测试时按 ECOM_ENV_FILE 读取
# 缺 ECOM_MODE 或 ECOM_DATABASE_URL 会直接启动失败，不要省略
ECOM_MODE="production"            # 仅允许 production / test
ECOM_ENV_FILE="/path/to/.env.production"
ECOM_DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:15432/ecom_production"
ECOM_TENANT_CODE="mofa"

# ─── 基础设施（企业在线链路：MinIO 附件 / Kafka 任务 / ES 检索） ───
# 三者均可独立关闭并自动降级：附件回落本地私有目录，任务回落数据库轮询，检索回落本地五信号链路
ECOM_MINIO_ENABLED="false"
ECOM_MINIO_ENDPOINT="127.0.0.1:19000"
ECOM_MINIO_ACCESS_KEY=""
ECOM_MINIO_SECRET_KEY=""
ECOM_MINIO_BUCKET="ecom-private"
ECOM_MINIO_SECURE="false"
# 若配置外部 S3/CDN 域名才签发预签名跳转；留空则由 API 安全代理输出原件
ECOM_MINIO_PUBLIC_ENDPOINT=""
ECOM_PRESIGN_TTL="600"
ECOM_RUNTIME_DIR=""
ECOM_QUICK_EVAL_PASSWORD=""
# 迁移期双写：MinIO 与本地目录同时落盘，比对一致后置 false 停写本地
ECOM_BLOB_DUAL_WRITE="false"

ECOM_KAFKA_ENABLED="false"
ECOM_KAFKA_BROKERS="127.0.0.1:9092"
ECOM_KAFKA_TOPIC="ecom.tasks"
ECOM_KAFKA_PARTITIONS="6"

ECOM_ES_ENABLED="false"
ECOM_ES_URL="http://127.0.0.1:9200"
ECOM_ES_INDEX="chunks"
# 中文分词：需集群已安装 analysis-ik；缺失时自动回落内置 cjk
ECOM_ES_ANALYZER="ik_max_word"
ECOM_ES_SEARCH_ANALYZER="ik_smart"

# ─── 检索质量（企业在线链路，改前先跑 scripts/experiment_distance_threshold.py 看数据）───
ECOM_ANN_MAX_DIST="0.45"          # 存在性闸门：最近切片距离仍超此值即判资料不足
ECOM_RERANK_ENABLED="true"
ECOM_RERANK_CANDIDATES="30"
ECOM_RERANK_TIMEOUT="20"          # 精排超时即回落融合序，不拖慢问答
ECOM_RERANK_CHARS="1000"          # 送交叉编码器的单条字符预算
ECOM_RERANK_MIN_SCORE="0.05"      # 精排分绝对阈值
ECOM_RERANK_RELATIVE="0.15"       # 精排分相对阈值（低于首条该比例即丢弃）
ECOM_MAX_CHUNKS_PER_DOC="3"       # 同一文档最多进入结果的切片数
ECOM_QUOTE_MAX_CHARS="1200"       # 单条正文兜底截断长度
ECOM_CHUNK_SIZE="850"             # 结构化切片单块字符上限
ECOM_CHUNK_OVERLAP="200"          # 相邻切片行/句重叠预算
ECOM_ADAPTIVE_HYDE="true"         # 自适应 HyDE（首轮命中高置信时跳过 LLM 调用）
ECOM_HYDE_RERANK_THRESHOLD="0.65" # 自适应 HyDE 触发精排分阈值
ECOM_HYDE_MAX_TOKENS="220"        # HyDE 生成段落最大 Token 预算
ECOM_HYDE_PASSAGE_CHARS="800"     # HyDE 送入向量的最大字符数
ECOM_RECENCY_BOOST="0.08"         # 同系列版本/新近生效文档排序微调权重
ECOM_ENTITY_QUOTA="2"             # 多实体对比提问时按实体文档保留配额
ECOM_SEMANTIC_CACHE_THRESHOLD="0.96" # 语义缓存余弦命中阈值（严防跨型号误命中）
ECOM_SEMANTIC_CACHE_TTL="3600"    # 语义缓存条目生存期（秒）
ECOM_SEMANTIC_CACHE_MAX_ENTRIES="10000"
ECOM_SPECIALIST_TIMEOUT="45"      # 专家智能体单次模型超时（秒）
ECOM_SPECIALIST_MAX_TOKENS="4096" # 专家智能体最大输出 Token 预算
ECOM_SPECIALIST_CONCURRENCY="2"   # 单次任务专家并发窗口
ECOM_API_BASE_URL="http://127.0.0.1:18080"

# ─── Agent 编排与业务接口 ───
MAX_PARALLEL_SUBAGENTS=4
BUSINESS_API_URL=
BUSINESS_API_TOKEN=

# ─── 语义检索（本地嵌入服务，scripts/embedding_server.py 或 embedding 容器） ───
# 服务不可用时检索自动降级为 BM25+字符向量两路；留空则使用默认地址
EMBED_HOST="127.0.0.1"
EMBED_DEVICE="cpu"
ECOM_EMBED_SERVICE_URL="http://127.0.0.1:18555"
# HyDE：检索前由 LLM 生成假设性答案作为第四路检索信号；false 时关闭
ECOM_HYDE_ENABLED="true"

# ─── 构建期依赖源（可选，国内网络建议配置） ───
# 容器构建时 npm/pip 使用的镜像源；留空则使用官方源 registry.npmjs.org / pypi.org
NPM_REGISTRY=
PIP_INDEX_URL=
# PyTorch 轮子源；留空使用官方 download.pytorch.org，国内可指向镜像站
# 直接指定 PyTorch 轮子 URL（可选，国内网络可显著加速；留空则按 TORCH_INDEX_URL 解析）
