BASE_URL="https://token.sensenova.cn/v1"
API_KEY=""
MODEL="sensenova-6.8-flash"

LLM_FAST_MODEL=""
LLM_STRONG_MODEL=""
LLM_VISION_MODEL=""
LLM_MAX_TOKENS=8192
LLM_DIRECT_CONNECTION=true

SENSENOVA_OVERSEAS_BASE_URL="https://token.sensenova.ai/v1"
SENSENOVA_OVERSEAS_API_KEY=""
SENSENOVA_OVERSEAS_MODEL="sensenova-6.8-flash"
SENSENOVA_OVERSEAS_DIRECT_CONNECTION="false"
DOTS_BASE_URL="https://note3-prev-api.askdiandian.com/v1"
DOTS_API_KEY=""
DOTS_MODEL="dots3-note-prev"
DOTS_DIRECT_CONNECTION="true"
SENSENOVA_CN_SECONDARY_API_KEY=""

ECOM_PG_USER="ecom_production"
ECOM_PG_PASSWORD=""
ECOM_PG_DB="ecom_production"
ECOM_MODELS_DIR="../models"

ECOM_MODE="production"
# 测试库口令：load_config() 在 ECOM_MODE=test 时读取 config/test.env，口令由此注入，不写进连接串
PGPASSWORD=
ECOM_DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:15432/ecom_production"
ECOM_TENANT_CODE="mofa"

ECOM_MINIO_ENABLED="false"
ECOM_MINIO_ENDPOINT="127.0.0.1:19000"
ECOM_MINIO_ACCESS_KEY=""
ECOM_MINIO_SECRET_KEY=""
ECOM_MINIO_BUCKET="ecom-private"
ECOM_MINIO_SECURE="false"
ECOM_MINIO_PUBLIC_ENDPOINT=""
ECOM_PRESIGN_TTL="600"
ECOM_RUNTIME_DIR=""
ECOM_BLOB_DUAL_WRITE="false"

ECOM_KAFKA_ENABLED="false"
ECOM_KAFKA_BROKERS="127.0.0.1:9092"
ECOM_KAFKA_TOPIC="ecom.tasks"
ECOM_KAFKA_PARTITIONS="6"

ECOM_ES_ENABLED="false"
ECOM_ES_URL="http://127.0.0.1:9200"
ECOM_ES_INDEX="chunks"
ECOM_ES_ANALYZER="ik_max_word"
ECOM_ES_SEARCH_ANALYZER="ik_smart"

ECOM_ANN_MAX_DIST="0.45"
ECOM_RERANK_ENABLED="true"
ECOM_RERANK_CANDIDATES="30"
ECOM_RERANK_TIMEOUT="20"
ECOM_RERANK_CHARS="1000"
ECOM_RERANK_MIN_SCORE="0.05"
ECOM_RERANK_RELATIVE="0.15"
ECOM_MAX_CHUNKS_PER_DOC="3"
ECOM_QUOTE_MAX_CHARS="1200"
ECOM_CHUNK_SIZE="850"
ECOM_CHUNK_OVERLAP="200"
ECOM_ADAPTIVE_HYDE="true"
ECOM_HYDE_RERANK_THRESHOLD="0.65"
ECOM_HYDE_MAX_TOKENS="220"
ECOM_HYDE_PASSAGE_CHARS="800"
ECOM_RECENCY_BOOST="0.08"
ECOM_ENTITY_QUOTA="2"
ECOM_SEMANTIC_CACHE_THRESHOLD="0.96"
ECOM_SEMANTIC_CACHE_TTL="3600"
ECOM_SEMANTIC_CACHE_MAX_ENTRIES="10000"
ECOM_SPECIALIST_TIMEOUT="45"
ECOM_SPECIALIST_MAX_TOKENS="4096"
ECOM_SPECIALIST_CONCURRENCY="2"
ECOM_API_BASE_URL="http://127.0.0.1:18080"

# 容器启动闸门：API/Worker 入口等待依赖就绪的整体超时与探测间隔（秒）
ECOM_STARTUP_WAIT_SECONDS="600"
ECOM_STARTUP_PROBE_INTERVAL="2"

MAX_PARALLEL_SUBAGENTS=4
BUSINESS_API_URL=
BUSINESS_API_TOKEN=

EMBED_HOST="127.0.0.1"
EMBED_DEVICE="cpu"
# 显式 cuda 时等待宿主机 GPU 直通就绪的启动宽限期（秒）
EMBED_GPU_BOOT_GRACE_SECONDS="180"
ECOM_EMBED_SERVICE_URL="http://127.0.0.1:18555"
ECOM_HYDE_ENABLED="true"
# 文本层为空的 PDF 页面按页回退 OCR 识别；缺依赖或需提速时设为 false
ECOM_OCR_ENABLED="true"

NPM_REGISTRY=
PIP_INDEX_URL=

# ─── 网页检索通道（可选） ───
# 公开 MCP 检索服务地址（示例：https://mcp.exa.ai/mcp）；留空则使用 DuckDuckGo / Bing
ECOM_MCP_SEARCH_URL=

# ─── 阿里云百炼（OpenAI 兼容模式，DeepSeek V4.1 Flash） ───
# 控制台创建 DashScope API Key 后填入；留空则该通道不参与路由
BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
BAILIAN_API_KEY=""
BAILIAN_MODEL="deepseek-v4.1-flash"
BAILIAN_DIRECT_CONNECTION="true"
